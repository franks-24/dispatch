rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only Firebase sessions authenticated through the Google provider may access data.
    function signedIn() { return request.auth != null && request.auth.token.firebase.sign_in_provider == 'google.com'; }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    // Bump the pinned version when publishing materially revised legal policies.
    function agreementPath(uid) {
      return /databases/$(database)/documents/agreements/$(uid)/versions/2026-10-30-v1;
    }
    function hasCurrentAgreement() {
      return signedIn() && exists(agreementPath(request.auth.uid));
    }
    function hasProfile() {
      return signedIn() && hasCurrentAgreement() && exists(userPath(request.auth.uid));
    }
    function hasRole(role) { return hasProfile() && get(userPath(request.auth.uid)).data.role == role; }
    function approvalPath(uid) { return /databases/$(database)/documents/employerApprovals/$(uid); }
    // Employer verification is administered through privileged Firebase Console/Admin SDK access.
    // A client cannot create or modify its own approval record.
    function isApprovedEmployer() {
      return hasRole('employer')
        && exists(approvalPath(request.auth.uid))
        && get(approvalPath(request.auth.uid)).data.status == 'approved';
    }
    function validProfileFields() {
      return request.resource.data.keys().hasOnly([
        'displayName','email','location','phone','skills','role','photoURL','createdAt','updatedAt'
      ]) && request.resource.data.keys().hasAll(['displayName','email','location','role','createdAt','updatedAt'])
      && request.resource.data.displayName is string && request.resource.data.displayName.size() > 0
      && request.resource.data.displayName.size() <= 100
      && request.resource.data.location is string && request.resource.data.location.size() > 0
      && request.resource.data.location.size() <= 120
      && request.resource.data.email == request.auth.token.email
      && request.resource.data.role in ['worker','employer'];
    }
    // Append-only acceptance evidence. Client cannot falsify acceptedAt, retract flags,
    // accept for a different identity or overwrite the existing acceptance record.
    match /agreements/{uid}/versions/{version} {
      allow get: if signedIn() && uid == request.auth.uid;
      allow list: if false;
      allow create: if signedIn() && uid == request.auth.uid
        && version == '2026-10-30-v1'
        && request.resource.data.keys().hasOnly([
          'uid','email','version','termsAccepted','privacyAcknowledged',
          'ownershipAcknowledged','acceptedAt'
        ])
        && request.resource.data.keys().hasAll([
          'uid','email','version','termsAccepted','privacyAcknowledged',
          'ownershipAcknowledged','acceptedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.version == version
        && request.resource.data.termsAccepted == true
        && request.resource.data.privacyAcknowledged == true
        && request.resource.data.ownershipAcknowledged == true
        && request.resource.data.acceptedAt == request.time;
      allow update, delete: if false;
    }
    match /users/{uid} {
      allow read: if signedIn() && uid == request.auth.uid;
      allow create: if signedIn() && hasCurrentAgreement() && uid == request.auth.uid && validProfileFields();
      allow update: if signedIn() && hasCurrentAgreement() && uid == request.auth.uid && validProfileFields()
                    && request.resource.data.role == resource.data.role
                    && request.resource.data.email == resource.data.email
                    && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }
    match /employerApprovals/{uid} {
      allow get: if hasProfile() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    match /jobs/{jobId} {
      allow read: if hasProfile();
      allow create: if isApprovedEmployer()
        && request.resource.data.keys().hasOnly(['title','description','location','type','compensation','status','createdBy','createdAt','updatedAt'])
        && request.resource.data.keys().hasAll(['title','description','location','type','compensation','status','createdBy','createdAt','updatedAt'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120
        && request.resource.data.description is string && request.resource.data.description.size() > 0 && request.resource.data.description.size() <= 3000
        && request.resource.data.location is string && request.resource.data.location.size() > 0 && request.resource.data.location.size() <= 120
        && request.resource.data.type in ['Contract','Part-time','Full-time','Once-off'];
      allow update: if hasRole('employer') && resource.data.createdBy == request.auth.uid
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['status','updatedAt'])
        && (request.resource.data.status == 'closed' || (isApprovedEmployer() && request.resource.data.status == 'open'));
      // Revoked employers can close existing posts, but cannot reopen or publish them.
      allow delete: if false;
    }
    match /applications/{applicationId} {
      allow create: if hasRole('worker')
        && request.resource.data.keys().hasOnly(['jobId','applicantId','status','createdAt'])
        && request.resource.data.keys().hasAll(['jobId','applicantId','status','createdAt'])
        && request.resource.data.applicantId == request.auth.uid
        && applicationId == request.resource.data.jobId + '_' + request.auth.uid
        && request.resource.data.status == 'submitted'
        && exists(/databases/$(database)/documents/jobs/$(request.resource.data.jobId))
        && get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.status == 'open';
      allow read: if hasProfile() && (
        resource.data.applicantId == request.auth.uid
        || (hasRole('employer') && get(/databases/$(database)/documents/jobs/$(resource.data.jobId)).data.createdBy == request.auth.uid)
      );
      allow update, delete: if false;
    }
  }
}
