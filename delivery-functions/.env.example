DELIVERY_ENABLED=false
DELIVERY_DATABASE_ID=
DELIVERY_DATABASE_EDITION=STANDARD
DELIVERY_POLICY_VERSION=
DELIVERY_PROOF_BUCKET=
# Local operator only, not a secret or an authentication mechanism:
DELIVERY_OPERATOR_LABEL=

# Dispatcher flags remain false until trusted Workspace connector is configured.
DISPATCH_SESSION_ENABLED=false
DISPATCH_INVENTORY_ENABLED=false
DISPATCH_DATABASE_ID=
DISPATCH_INVENTORY_BUCKET=
DISPATCH_WORKSPACE_CUSTOMER_ID=
DISPATCH_GROUP_EMAIL=
DISPATCH_DELEGATED_ADMIN_EMAIL=
# DISPATCH_DIRECTORY_SA_JSON is a Google Cloud Secret Manager secret, never put it in this .env file.
