{
  "name": "franks24-dispatch",
  "private": true,
  "version": "0.1.0",
  "description": "Dispatch Firebase rules validation tooling",
  "type": "module",
  "scripts": {
    "test:rules": "firebase emulators:exec --project dispatch-rules-test --only firestore \"node --test tests/firestore.rules.test.mjs\"",
    "test:onboarding": "node --test tests/onboarding.test.mjs",
    "test:identity:unit": "node --test tests/identity/session.test.mjs",
    "test:identity": "firebase emulators:exec --project demo-dispatch-identity --only auth,firestore \"node tests/identity/prepare.mjs && playwright test --config tests/identity/playwright.config.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.10.0",
    "firebase-tools": "^14.0.0",
    "@playwright/test": "^1.51.1",
    "esbuild": "^0.25.0"
  }
}
