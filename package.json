{
  "name": "franks24-dispatch",
  "private": true,
  "version": "0.1.0",
  "description": "Franks24 courier delivery, identity and Firebase rules validation",
  "type": "module",
  "scripts": {
    "test:rules": "firebase emulators:exec --project dispatch-rules-test --only firestore \"node --test tests/firestore.rules.test.mjs\"",
    "test:onboarding": "node --test tests/onboarding.test.mjs",
    "test:config": "node --test tests/firebase-config.test.mjs",
    "test:identity:unit": "node --test tests/identity/session.test.mjs tests/identity/activation.test.mjs",
    "test:identity": "playwright test --config tests/identity/playwright.config.mjs",
    "test:deliveries": "node --test tests/deliveries.test.mjs tests/delivery-interactions.test.mjs",
    "test:dispatcher": "node --test tests/dispatcher.test.mjs tests/dispatcher-routing.test.mjs delivery-functions/tests/dispatcher-auth.test.mjs",
    "test:release": "node --test tests/release-manifest.test.mjs",
    "test:operations": "node --test delivery-functions/tests/operations.test.mjs tests/capture-regressions.test.mjs tests/operations-ui.test.mjs tests/pages-publisher.test.mjs",
    "test:site": "node --test tests/site-navigation.test.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.10.0",
    "firebase-tools": "^14.0.0",
    "@playwright/test": "^1.51.1",
    "esbuild": "^0.25.0"
  }
}
